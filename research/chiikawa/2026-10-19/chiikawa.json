  "mechanisms": [
    {
      "claim": "柔软外形承接有代价的生活。",
      "type": "inference",
      "evidence": "官方简介同时出现快乐、辛酸与艰难；第二卷简介写劳动、资格考试、报酬和给朋友买礼物。",
      "boundary": "内容反差有一手依据；它如何驱动购买尚缺消费者研究。不是所有读者都把角色当成打工人。",
      "sources": [
        "S01",
        "S19"
      ]
    },
    {
      "claim": "角色关系让情绪有来有回。",
      "type": "inference",
      "evidence": "三角色共享简单线条，却有耳形、配色和表达方式差异；小八有清晰台词，获授权玩具收录100余句。",
      "boundary": "三人组只是主要样本，不是全部角色。不能把差异诊断成人格疾病，也不把小八说成全角色群唯一会说话者。",
      "sources": [
        "S01",
        "S18"
      ]
    },
    {
      "claim": "把记得的情节变成能带走的物件。",
      "type": "inference",
      "evidence": "毛量变化毛绒、漫画马克杯、日常片段亚克力与带劳动玩法的电子玩具，连接内容与载体。",
      "boundary": "商品存在已核实；熟悉剧情是否提高复购、哪个品类最畅销，尚无数据。",
      "sources": [
        "S13",
        "S15",
        "S16",
        "S17"
      ]
    }
  ],
  "counterexamples": "2025年部分草莓费南雪包装封口不足出现霉菌，实施限定范围召回；整盒随机立牌不保证集齐；未核实全IP质量缺陷率或失败系列。",
  "theory": {
    "shell": "大白色块、小五官、短肢与群像差异降低视觉读取负担。",
    "core": "劳动、考试、恐惧与分享并存，让柔软外壳有具体生活。",
    "shadow": "圆形、小耳、粉颊是常见元素；差异来自比例组合、线条和持续关系，不能单凭公共元素判断商业效果。",
    "two_layers": {
      "surface": "路人可能先喜欢可爱外形或日常用品；属于假设。",
      "deep": "熟悉者可能认出毛量、考试和朋友互动；剧情辨识是否转化复购待验证。"
    },
    "validation": "平台成交额和电影票房强于点赞，但均不解释个人购买动机；指定笔记可见评论不能代表消费者调查。"
  },
  "for_skills": {
    "lab": "先写具体的生活难题和角色的应对方式；允许脆弱与行动共存，不只贴治愈标签。",
    "form": "可借大色块和小表情之间的尺度关系、角色群的差异化规则；不能搬白团五官与三人组识别组合。",
    "studio": "优先让商品记住一个内容瞬间，再匹配毛绒、图案、互动等载体。随机规则与食品质量必须逐款核对，销售效果待测。"
  },
  "gaps": [
    "最早X原帖本轮403，2017原型和2020年1月专门账号时间来自二手资料。",
    "未取得简体漫画版权页、授权合同和全部地域期限。",
    "全球IP收入、授权收入、SKU销量、利润、复购和受众人口分布未知。",
    "小红书仅指定一篇及可见内容，两组站内搜索遇登录墙。",
    "本轮六个代表视觉样本已逐图查看，未看漫画全卷或电影全片。",
    "V4仅单次纯文字中文平面结果接近，尚未做重复稳定性测试；耳、手脚偏大。",
    "英文、原创黑白找形、原创平面上色与实物概念未测试，本轮不作为正式可用词交付。",
    "没有与相似但未成功IP的同口径对照，也没有独立失败系列销售数据。"
  ],
