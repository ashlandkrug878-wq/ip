    "access_status": "正文相关段落已读",
    "claims": [
      {
        "type": "self_report",
        "text": "作者设想孤独男孩进入梦乡，云妈妈把云宝宝放其头顶作头发与冒险伙伴；世界里多个角色由两种生物共同组成。"
      },
      {
        "type": "self_report",
        "text": "男孩灵感来自朋友家的怕生孩子，遇感兴趣的事会走出舒适圈；起初是平面，后转立体玩具。"
      },
      {
        "type": "self_report",
        "text": "首系列迷途中云可变不同动物；合作后POP MART协助规划开发、工业供应链与渠道。"
      }
    ],
    "boundary": "角色故事和创作意图为作者直接自述；不能把“治愈”当临床效果，也不能从作者对社群归属的看法推出所有消费者动机。",
    "web_refs": [
