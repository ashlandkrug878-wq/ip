  "mechanisms": [
    {
      "claim": "把“想变得可爱”放进日常动作。",
      "type": "inference",
      "evidence": "作者强调贴近日常；2020合作进入穿搭，2025镜梳进入整理仪容。",
      "boundary": "商品与定位可核；接触频率、购买动机和复购效果未经用户研究。",
      "sources": [
        "S02",
        "S08",
        "S13"
      ]
    },
    {
      "claim": "共用一套表情语法，再用动物轮廓形成角色群。",
      "type": "inference",
      "evidence": "V02群像共享弯曲刘海、小睫毛眼、粉颊；耳形、体色和配件不同。",
      "boundary": "视觉归纳；不等于每个角色的人设相同，也不能证明多角色提高销量。",
      "sources": [
        "S01",
        "S07"
      ]
    },
    {
      "claim": "让柔软与装扮同时存在。",
      "type": "inference",
      "evidence": "毛绒本体搭配蝴蝶结；联名把头套、蕾丝与印花扩展到包袋和镜子。",
      "boundary": "柔软是外观或厂商材料描述；未测手感、耐洗性、实际触摸偏好或利润。",
      "sources": [
        "S04",
        "S06"
      ]
    }
  ],
  "counterexamples": "未核到具体失败款或召回。官方日本商城会员、国内配送、购物车不锁货等是购买摩擦，不是实际投诉率。",
  "theory": {
    "shell": "宽脸与大额头留白承接低位小五官，刘海和睫毛增加精致感；群像共享语法。",
    "core": "Mousse努力、害羞和装扮愿望；角色群用喜欢与梦想陪伴日常。",
    "shadow": "猫、蝴蝶结、腮红和睫毛都是公共元素，差异落在比例、线条和持续的日常语境，不能只靠装饰宣称独创。",
    "two_layers": {
      "surface": "路人可能先看上柔软外形或好用的包袋镜梳，是假设。",
      "deep": "熟悉者可能按成员、刘海与配对选择周边，是假设，未做买家访谈。"
    },
    "validation": "商品在架、跨品牌合作与历史粉丝数能证明传播及供给；缺少独立成交证据，不能宣布商业机制已验证。"
  },
  "for_skills": {
    "lab": "将陪伴落实到整理仪容、穿搭或随身收纳等具体时刻；先确定新角色的态度。",
    "form": "可借小五官与留白的尺度关系、角色群共用语法；新轮廓、发型和五官组合必须独立设计。",
    "studio": "先按使用场景选择毛绒、镜梳或织物；区分本体识别色、主题配件和背景，材料效果须打样。"
  },
  "gaps": [
    "首次角色创作及首发原帖未取得；2013是作者职业起步。",
    "代理合同地区、期限、独家性及Anova旧约终止情况未知。",
    "独立IP收入、版税、销量、中国GMV及复购全部未知。",
    "小红书只读到标题、标签和模糊封面；18张内页未读完，评论0条可用；两组搜索均被登录墙阻挡。",
    "6个视觉样本已目检，普通毛绒是正面和近景，未取得背面或内部结构；未阅读mook全部16页。",
    "纯文字V1–V3仍有明显偏差；参考辅助V2仅在官网头像二维范围接近。",
    "英文、重复稳定性、全身、侧背面、实物概念、原创转译均未实测；本轮停止于平面头像。",
    "未核到具体召回、商业失败款或同口径未成功IP对照；不能写从未失败。"
  ],
