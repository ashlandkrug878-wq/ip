  "persona": [
    {
      "word": "面包已有",
      "basis": "2018-04-23 半岛网转述《21克拉》宣传：被问面包还是爱情时，她的回答被记成已经有面包，并说真正的爱情是势均力敌。后援会新粉指南用「面包小达人」。",
      "type": "self",
      "sources": ["s13", "s8"]
    },
    {
      "word": "放走蝴蝶",
      "basis": "2026-10 下旬 Vogue 时尚盛典雨中红毯后，小红书热评写蝴蝶放飞后毫不留恋、没有盯镜头、没有讨好感。这是观众对现场的读法，不是她的自我介绍。",
      "type": "fan",
      "sources": ["s27", "s5", "s25"]
    },
    {
      "word": "步履不停",
      "basis": "后援会新粉指南的签名语是「一生热爱，步履不停！」。另一条粉丝口号则说累了就回头。两句并置，不把签名语当成她的口头禅原话。",
      "type": "self",
      "sources": ["s8", "s15"]
    },
    {
      "word": "不看镜头",
      "basis": "同一场红毯的热评里，「没有盯镜头，没有讨好感」单独被点出。和复刻造型、复刻妆的高赞内容对着看：画面被人留下，她被读成已经走过去。",
      "type": "fan",
      "sources": ["s27", "s26", "s25"]
    }
  ],
  "catchphrases": [
    {
      "text": "吾心向迪，永不分离，天南地北，我迪最美。",
      "type": "fan",
      "sources": ["s7", "s16"]
    },
    {
      "text": "热巴累了就回头，爱丽丝在你身后。",
      "type": "fan",
      "sources": ["s15", "s16"]
    },
    {
      "text": "一生热爱，步履不停！",
      "type": "self",
      "sources": ["s8"],
      "note": "后援会新粉指南签名语。"
    },
    {
      "text": "可乐要加冰，爱迪要用心。",
      "type": "fan",
      "sources": ["s28"]
    },
    {
      "text": "面包我有。",
      "type": "self",
      "sources": ["s13"],
      "note": "2018-04-23 媒体对宣传问答的转述，不是逐字采访稿。"
