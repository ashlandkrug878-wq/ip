  "theory": {
    "shell": "尖耳、宽嘴九牙与头脸布局共同保持身份；商品层的颜色、眼神和姿态可变。",
    "core": "顽皮与善良反差",
    "shadow": "避免复刻尖耳、九牙坏笑与毛绒精灵的特征组合",
    "two_layers": {
      "surface": "可携带的角色陪伴（候选解释）",
      "deep": "绘本世界与角色关系"
    },
    "validation": "财务收入证明家族购买规模，不证明某种消费者动机。已阅读用户指定小红书笔记6张图及13条可见评论项；单帖不代表整体用户。"
  },
  "for_skills": {
    "lab": "可测试顽皮与善良的矛盾表达；不要把未经验证的消费者隐含表达当事实。",
    "form": "借鉴识别特征跨载体保持连续；不复刻尖耳九牙坏笑组合。当前平面复现关卡未通过，暂停后续转译。",
    "studio": "便携结构与系列主题联动可作为待验证机制；当前平面关卡未通过，不进入材质、立体化或原创转译。"
  },
  "gaps": [
    "授权范围、年限、分成及完整权属链",
